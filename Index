<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget & Scenarios App</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    
    <script src="https://unpkg.com/@supabase/supabase-js@2"></script>

    <style>
        /* Custom Toggle Switch Style */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #10B981;
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: #10B981;
        }
        [v-cloak] { display: none; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800">

    <div id="app" v-cloak class="max-w-6xl mx-auto p-4 md:p-8">

        <div v-if="!session" class="min-h-[80vh] flex flex-col items-center justify-center">
            <div class="bg-white p-8 rounded-xl shadow-xl max-w-md w-full border border-slate-200 text-center">
                <div class="text-5xl mb-4">🔐</div>
                <h1 class="text-2xl font-bold mb-2 text-slate-800">Budget Login</h1>
                <p class="text-slate-500 mb-6 text-sm">Enter your email to receive a Magic Link.</p>
                
                <input 
                    v-model="authEmail" 
                    type="email" 
                    placeholder="name@example.com" 
                    class="w-full p-3 border border-slate-300 rounded-lg mb-4 bg-slate-50 focus:ring-2 focus:ring-slate-800 outline-none"
                    @keyup.enter="handleLogin"
                >
                
                <button 
                    @click="handleLogin" 
                    :disabled="loading"
                    class="w-full bg-slate-900 text-white font-bold py-3 rounded-lg hover:bg-slate-800 transition disabled:opacity-50">
                    {{ loading ? 'Sending Link...' : 'Send Magic Link' }}
                </button>
                <p v-if="authMessage" class="mt-4 text-emerald-600 text-sm font-medium bg-emerald-50 p-2 rounded">{{ authMessage }}</p>
            </div>
        </div>

        <div v-else>
            
            <div class="flex justify-between items-end mb-8 pb-4 border-b border-slate-200">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Household Budget</h1>
                    <div class="text-xs text-slate-400">User: {{ session.user.email }}</div>
                </div>
                <button @click="handleLogout" class="text-xs font-semibold text-red-500 hover:text-red-700">Sign Out</button>
            </div>

            <header class="mb-8 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Starting Balance</h2>
                    <div class="flex items-center gap-1 mt-1">
                        <span class="text-xl text-slate-400">$</span>
                        <input type="number" v-model="startingBalance" class="text-3xl font-bold w-full outline-none text-slate-700 placeholder-slate-200" placeholder="0">
                    </div>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                    <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Monthly Commitments</h2>
                    <div class="text-3xl font-bold mt-1 text-red-500">-${{ totalMonthlyBurn.toLocaleString() }}</div>
                </div>

                <div class="bg-slate-900 text-white p-6 rounded-xl shadow-lg relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-10 text-6xl transform translate-x-2 -translate-y-2">🔮</div>
                    <div class="relative z-10">
                        <h2 class="text-xs font-bold uppercase tracking-wider flex items-center gap-2">
                            <span :class="isScenarioActive ? 'text-emerald-400' : 'text-slate-400'">
                                {{ isScenarioActive ? '⚡ Scenario Active' : 'Projected End Balance' }}
                            </span>
                        </h2>
                        <div class="text-4xl font-bold mt-2 transition-colors duration-300" 
                             :class="projectedBalance >= 0 ? 'text-emerald-300' : 'text-red-300'">
                            ${{ projectedBalance.toLocaleString() }}
                        </div>
                    </div>
                </div>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <div class="lg:col-span-2">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold flex items-center gap-2">📅 Current Month Bills</h3>
                        <button @click="fetchBills" class="text-xs text-slate-400 hover:text-slate-600">Refresh</button>
                    </div>

                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-100">
                                <tr>
                                    <th class="p-4 w-32">Due Date</th>
                                    <th class="p-4">Bill Name</th>
                                    <th class="p-4 text-right">Amount</th>
                                    <th class="p-4 text-center w-24">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <tr v-for="bill in bills" :key="bill.id" class="group hover:bg-slate-50 transition" :class="{'bg-green-50/50': bill.is_paid}">
                                    <td class="p-4 text-sm font-medium" :class="isOverdue(bill) ? 'text-red-500' : 'text-slate-500'">
                                        {{ formatDate(bill.due_date) }}
                                        <span v-if="isOverdue(bill)" class="block text-[10px] uppercase font-bold">Overdue</span>
                                    </td>
                                    <td class="p-4 font-medium text-slate-700">{{ bill.budget_items.name }}</td>
                                    <td class="p-4 text-right font-mono text-slate-600">${{ bill.budget_items.amount }}</td>
                                    <td class="p-4 text-center">
                                        <input type="checkbox" 
                                               v-model="bill.is_paid" 
                                               @change="toggleBillPaid(bill)"
                                               class="w-5 h-5 text-emerald-600 rounded focus:ring-emerald-500 cursor-pointer accent-emerald-600">
                                    </td>
                                </tr>
                                <tr v-if="bills.length === 0">
                                    <td colspan="4" class="p-10 text-center text-slate-400">
                                        No bills found for this month.<br>
                                        <span class="text-xs opacity-75">(They generate on the 1st via Supabase)</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="space-y-6">
                    
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4">
                        <div class="flex justify-between items-center cursor-pointer select-none" @click="showAddForm = !showAddForm">
                            <h3 class="font-bold text-slate-700 text-sm">➕ Add New Item</h3>
                            <span class="text-slate-400 font-bold text-lg transition-transform" :class="showAddForm ? 'rotate-45' : ''">+</span>
                        </div>

                        <div v-if="showAddForm" class="mt-4 space-y-3 pt-4 border-t border-slate-100">
                            <input v-model="newItem.name" type="text" placeholder="Name (e.g. Netflix)" class="w-full p-2 border rounded text-sm bg-slate-50">
                            <div class="grid grid-cols-2 gap-2">
                                <input v-model="newItem.amount" type="number" placeholder="$ Amount" class="w-full p-2 border rounded text-sm bg-slate-50">
                                <input v-model="newItem.due_day" type="number" min="1" max="31" placeholder="Day Due" class="w-full p-2 border rounded text-sm bg-slate-50">
                            </div>
                            <button 
                                @click="addBudgetItem" 
                                :disabled="isSubmitting"
                                class="w-full bg-slate-800 text-white font-bold py-2 rounded text-sm hover:bg-slate-700 transition disabled:opacity-50">
                                {{ isSubmitting ? 'Saving...' : 'Save Item' }}
                            </button>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-lg font-bold mb-4 flex items-center gap-2">🔮 Scenario Planner</h3>
                        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 max-h-[600px] overflow-y-auto">
                            <p class="text-xs text-slate-400 mb-4">Toggle items OFF to simulate removing them from your budget.</p>
                            
                            <div class="space-y-2">
                                <div v-for="item in budgetItems" :key="item.id" 
                                     class="flex items-center justify-between p-3 border rounded-lg transition-all duration-300" 
                                     :class="item.includedInScenario ? 'border-slate-200 bg-white' : 'border-slate-100 bg-slate-50 opacity-50 grayscale'">
                                    
                                    <div>
                                        <div class="font-bold text-sm text-slate-700">{{ item.name }}</div>
                                        <div class="text-xs text-slate-500 font-mono">${{ item.amount }}</div>
                                    </div>

                                    <div class="relative inline-block w-10 mr-2 align-middle select-none">
                                        <input type="checkbox" :id="'toggle-'+item.id" 
                                               v-model="item.includedInScenario" 
                                               class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer border-slate-300 transition-all duration-300 ease-in-out"
                                               style="top: 2px; left: 2px;"/>
                                        <label :for="'toggle-'+item.id" class="toggle-label block overflow-hidden h-6 rounded-full bg-slate-300 cursor-pointer transition-colors duration-300 ease-in-out"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
        const { createApp, ref, computed, onMounted } = Vue
        const { createClient } = supabase

        // --- CONFIGURATION ---
        // ⚠️ REPLACE THESE WITH YOUR KEYS FROM SUPABASE DASHBOARD -> SETTINGS -> API
        const SUPABASE_URL = 'https://kqlfofxarceetacxfecb.supabase.co'
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtxbGZvZnhhcmNlZXRhY3hmZWNiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjgzMzg5NzAsImV4cCI6MjA4MzkxNDk3MH0.TTgtFZqm3BsO2dNDA0OxQ8Pfy5Z74HoCzuR9NUlUoCQ'

        const _supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY)

        createApp({
            setup() {
                // --- Auth State ---
                const session = ref(null)
                const authEmail = ref('')
                const loading = ref(false)
                const authMessage = ref('')

                // --- App State ---
                const startingBalance = ref(5000) // Default starting
                const budgetItems = ref([])
                const bills = ref([])
                const showAddForm = ref(false)
                const isSubmitting = ref(false)
                const newItem = ref({ name: '', amount: '', due_day: '', category: 'Expense' })

                // --- AUTH METHODS ---
                const handleLogin = async () => {
                    if(!authEmail.value) return alert("Please enter an email")
                    loading.value = true
                    const { error } = await _supabase.auth.signInWithOtp({
                        email: authEmail.value,
                        options: { emailRedirectTo: window.location.href }
                    })
                    if (error) alert(error.message)
                    else authMessage.value = "Link sent! Check your inbox."
                    loading.value = false
                }

                const handleLogout = async () => {
                    await _supabase.auth.signOut()
                    session.value = null
                    budgetItems.value = []
                    bills.value = []
                }

                // --- DATA METHODS ---
                const fetchBudgetItems = async () => {
                    const { data, error } = await _supabase
                        .from('budget_items')
                        .select('*')
                        .eq('is_active', true)
                        .order('amount', { ascending: false }) // Biggest bills first
                    
                    if (data) {
                        // Initialize local scenario state
                        budgetItems.value = data.map(item => ({ ...item, includedInScenario: true }))
                    }
                }

                const fetchBills = async () => {
                    // Fetch bills for current month (simple version)
                    // In production, you might want to filter by date range
                    const { data, error } = await _supabase
                        .from('ledger')
                        .select(`*, budget_items (name, amount)`)
                        .order('due_date', { ascending: true })

                    if (data) bills.value = data
                }

                const addBudgetItem = async () => {
                    if (!newItem.value.name || !newItem.value.amount) return alert('Name and Amount required')
                    isSubmitting.value = true

                    const payload = {
                        user_id: session.value.user.id,
                        name: newItem.value.name,
                        amount: Number(newItem.value.amount),
                        due_day: Number(newItem.value.due_day) || 1,
                        frequency: 'monthly',
                        is_active: true
                    }

                    const { data, error } = await _supabase
                        .from('budget_items')
                        .insert([payload])
                        .select()

                    if (error) {
                        alert(error.message)
                    } else if (data) {
                        budgetItems.value.push({ ...data[0], includedInScenario: true })
                        newItem.value = { name: '', amount: '', due_day: '', category: 'Expense' }
                        showAddForm.value = false
                    }
                    isSubmitting.value = false
                }

                const toggleBillPaid = async (bill) => {
                    await _supabase.from('ledger').update({ is_paid: bill.is_paid }).eq('id', bill.id)
                }

                // --- COMPUTED LOGIC ---
                const totalMonthlyBurn = computed(() => {
                    // Sum of all active items in DB
                    return budgetItems.value.reduce((acc, item) => acc + Number(item.amount), 0)
                })

                const projectedBalance = computed(() => {
                    // Math: Starting Balance - (Sum of ENABLED scenario items)
                    const scenarioExpenses = budgetItems.value
                        .filter(item => item.includedInScenario)
                        .reduce((acc, item) => acc + Number(item.amount), 0)
                    return startingBalance.value - scenarioExpenses
                })

                const isScenarioActive = computed(() => {
                    // True if user has toggled anything OFF
                    return budgetItems.value.some(item => !item.includedInScenario)
                })

                // --- UTILS ---
                const formatDate = (dateStr) => {
                    const date = new Date(dateStr)
                    // Fix JS timezone offset issues by using UTC methods for display
                    return new Date(date.valueOf() + date.getTimezoneOffset() * 60000)
                        .toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
                }

                const isOverdue = (bill) => {
                    if (bill.is_paid) return false
                    const today = new Date().toISOString().split('T')[0]
                    return bill.due_date < today
                }

                // --- LIFECYCLE ---
                onMounted(() => {
                    // Check Session
                    _supabase.auth.getSession().then(({ data }) => {
                        session.value = data.session
                        if (session.value) {
                            fetchBudgetItems()
                            fetchBills()
                        }
                    })

                    // Listen for Auth Changes (Magic Link click)
                    _supabase.auth.onAuthStateChange((_event, _session) => {
                        session.value = _session
                        if (_session) {
                            fetchBudgetItems()
                            fetchBills()
                        }
                    })
                })

                return {
                    session, authEmail, loading, authMessage,
                    startingBalance, budgetItems, bills, showAddForm, isSubmitting, newItem,
                    handleLogin, handleLogout, addBudgetItem, toggleBillPaid, fetchBills,
                    totalMonthlyBurn, projectedBalance, isScenarioActive, formatDate, isOverdue
                }
            }
        }).mount('#app')
    </script>
</body>
</html>
